<launch>
  <arg name="rate" default="6"/>
  <arg name="camera_time_offset" default="0"/>
  <arg name="point_half_window" default="0.05"/>
  <arg name="wait" default="3"/>
  <node pkg="lidar_rgbd_capture" type="lidar_depth_node" name="lidar_depth" required="true" output="screen">
    <param name="rate" value="$(arg rate)"/>
    <param name="camera_time_offset" value="$(arg camera_time_offset)"/>
    <param name="point_half_window" value="$(arg point_half_window)"/>
    <param name="wait" value="$(arg wait)"/>
  </node>
</launch>
