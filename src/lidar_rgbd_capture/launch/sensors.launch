<launch>
  <arg name="imu_source" default="hi226"/>
  <arg name="rviz" default="false"/>
  <arg name="fps" default="6"/>
  <arg name="rate" default="6"/>
  <arg name="camera_time_offset" default="0"/>
  <arg name="point_half_window" default="0.05"/>
  <param name="/camera/rgb_camera/auto_exposure_priority" type="bool" value="false"/>
  <include file="$(find agilex_lio)/launch/mapping.launch">
    <arg name="imu_source" value="$(arg imu_source)"/><arg name="rviz" value="$(arg rviz)"/>
    <arg name="camera" value="false"/>
  </include>
  <!-- Keep depth enabled to retain the driver's original camera_link reference
       profile. Its depth pixels are never consumed by this pipeline. -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="align_depth" value="false"/><arg name="enable_sync" value="false"/>
    <arg name="color_width" value="640"/><arg name="color_height" value="480"/>
    <arg name="depth_width" value="640"/><arg name="depth_height" value="480"/>
    <arg name="color_fps" value="$(arg fps)"/><arg name="depth_fps" value="$(arg fps)"/>
    <arg name="enable_pointcloud" value="false"/>
  </include>
  <include file="$(find lidar_rgbd_capture)/launch/projector.launch">
    <arg name="rate" value="$(arg rate)"/><arg name="camera_time_offset" value="$(arg camera_time_offset)"/>
    <arg name="point_half_window" value="$(arg point_half_window)"/>
  </include>
</launch>
